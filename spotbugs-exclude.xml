<?xml version="1.0" encoding="UTF-8"?>
<!--
    SpotBugs findings that are ignored on purpose. Every exclusion needs a reason.
    Do not add new exclusions to make the build pass; fix the code instead,
    or ask first.
-->
<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/master/spotbugs/etc/findbugsfilter.xsd">

    <!--
        EI_EXPOSE_REP / EI_EXPOSE_REP2: "may expose internal representation".
        Reported when a class stores or returns a mutable object it got from outside.
        In Spring this is how constructor injection works (e.g. SwopClient keeps the
        RestClient bean it receives), so in this project it is not a bug.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

</FindBugsFilter>